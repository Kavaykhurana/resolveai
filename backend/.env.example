# Gemini Developer API key from https://aistudio.google.com (required for LLM + embeddings)
GEMINI_API_KEY=

# PostgreSQL connection. Either set DB_URL directly, or set DB_HOST/DB_PORT/DB_NAME
# (Render blueprint wires the latter from its managed Postgres).
DB_URL=jdbc:postgresql://localhost:5432/resolveai
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=resolveai
DB_USER=kavaykhurana
DB_PASSWORD=

# Secret for signing JWTs (min 32 chars; generate a random one for production)
JWT_SECRET=

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# HTTP port (Render sets PORT automatically)
PORT=8080

# Set false to skip knowledge-base embedding ingestion at startup
KB_INGEST=true